{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/schema.json",
  "name": "pi-remote-relay",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-04-01",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_HUB",
        "class_name": "PiRelayHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiRelayHub"]
    }
  ]
}
