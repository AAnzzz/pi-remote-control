{
  "expo": {
    "name": "PI Remote",
    "slug": "pi-remote-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.piremote.companion",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan PI-Desktop pairing QR codes.",
        "NSFaceIDUsageDescription": "Confirm high-risk tool approvals."
      }
    },
    "android": {
      "package": "com.piremote.companion",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D10",
        "monochromeImage": "./assets/monochrome-icon.png"
      }
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Scan PI-Desktop pairing QR codes." }],
      "expo-secure-store",
      ["expo-local-authentication", { "faceIDPermission": "Confirm high-risk tool approvals." }],
      ["expo-build-properties", {
        "android": {
          "usesCleartextTraffic": true,
          "useLegacyPackaging": true
        }
      }]
    ]
  }
}
